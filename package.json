{
  "name": "flowtivo-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-pages.mjs",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/app.test.mjs",
    "mail:check": "node --env-file-if-exists=.env scripts/check-email.mjs",
    "mail:test": "node --env-file-if-exists=.env scripts/check-email.mjs --send-test",
    "mail:status": "node --env-file-if-exists=.env scripts/mail-status.mjs",
    "benchmark:contact": "node scripts/benchmark-contact.mjs"
  },
  "dependencies": {
    "@fillout/react": "^3.1.2",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^1.31.0",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
